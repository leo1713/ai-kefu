# 应用配置
DEBUG=true
SECRET_KEY=changeme-please-use-a-strong-random-key

# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_cs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_cs

# Redis
REDIS_URL=redis://localhost:6379/0

# Claude API（必填）
